# Copy to .env and adjust. Never commit .env.
# Variables are added here as each part of the system is introduced.

# Backend HTTP port
SERVER_PORT=8080

# MySQL connection used when running the backend against your own database.
# Not needed for tests or for `./mvnw spring-boot:test-run`, which start MySQL in Docker automatically.
DB_URL=jdbc:mysql://localhost:3306/enterpriseflow
DB_USERNAME=enterpriseflow
DB_PASSWORD=change-me
